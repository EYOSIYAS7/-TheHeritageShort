{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritage-short/schema/storyboard.schema.json",
  "title": "Storyboard",
  "description": "The single contract between every pipeline stage: shots, narration, cards, style, characters, narrator and music cue.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "saying", "end_card", "style", "characters", "script", "narrator", "music", "shots", "narration"],
  "properties": {
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "am"],
      "properties": {
        "en": { "$ref": "#/$defs/text" },
        "am": { "$ref": "#/$defs/text" }
      }
    },
    "saying": {
      "description": "The saying card: the Amharic saying and its English translation, shown just before the end card.",
      "type": "object",
      "additionalProperties": false,
      "required": ["am", "en", "duration_s"],
      "properties": {
        "am": { "$ref": "#/$defs/text" },
        "en": { "$ref": "#/$defs/text" },
        "duration_s": { "$ref": "#/$defs/duration" }
      }
    },
    "end_card": {
      "description": "The final card stating the film was made with AI.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "duration_s"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "duration_s": { "$ref": "#/$defs/duration" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["words", "grades", "character_sheet", "reference_images"],
      "properties": {
        "words": {
          "description": "Global style, described by qualities; no artist names.",
          "$ref": "#/$defs/text"
        },
        "character_sheet": {
          "description": "Prompt text for each character-sheet image, before the character's description.",
          "$ref": "#/$defs/text"
        },
        "reference_images": {
          "description": "True: keyframes are conditioned on the character-sheet images (FLUX.2 klein reference images). False: on the fixed descriptions and seeds only.",
          "type": "boolean"
        },
        "grades": {
          "type": "object",
          "additionalProperties": false,
          "required": ["copper", "gold"],
          "properties": {
            "copper": { "$ref": "#/$defs/text" },
            "gold": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "characters": {
      "description": "Fixed descriptions reused word for word in every keyframe prompt.",
      "type": "object",
      "additionalProperties": false,
      "required": ["father", "son", "coffee_corner"],
      "properties": {
        "father": { "$ref": "#/$defs/character" },
        "son": { "$ref": "#/$defs/character" },
        "coffee_corner": { "$ref": "#/$defs/character" }
      }
    },
    "script": {
      "description": "How the script stage drafts the Amharic narration from the English.",
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "seed"],
      "properties": {
        "instruction": { "description": "Translation instruction sent to the text model before each English line: tone, register, who is speaking.", "$ref": "#/$defs/text" },
        "seed": { "$ref": "#/$defs/seed" }
      }
    },
    "narrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "style", "seed", "voice_trial"],
      "properties": {
        "voice": { "$ref": "#/$defs/text" },
        "voice_reason": { "description": "Why this voice was chosen, after listening to the voice trial.", "type": ["string", "null"] },
        "style": { "$ref": "#/$defs/text" },
        "seed": { "$ref": "#/$defs/seed" },
        "voice_trial": {
          "description": "`make voices`: the same narration line spoken by each candidate voice, to pick the narrator by ear.",
          "type": "object",
          "additionalProperties": false,
          "required": ["line", "voices"],
          "properties": {
            "line": { "description": "Id of the narration line to speak.", "type": "string" },
            "voices": { "type": "array", "items": { "$ref": "#/$defs/text" }, "minItems": 1 }
          }
        }
      }
    },
    "music": {
      "description": "The music cue for the score.",
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "duration_s", "candidates", "seed", "chosen", "reason", "volume_points"],
      "properties": {
        "caption": { "$ref": "#/$defs/text", "maxLength": 512 },
        "duration_s": { "$ref": "#/$defs/duration" },
        "candidates": { "type": "integer", "minimum": 1, "maximum": 10 },
        "seed": { "description": "Seed of candidate 0; candidate i uses seed + i.", "type": "integer", "minimum": 0 },
        "chosen": {
          "description": "Index (0-based) of the chosen candidate, or null before choosing.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "reason": { "type": ["string", "null"] },
        "volume_points": {
          "description": "Score gain over time on the film timeline; linear between points.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["t_s", "gain"],
            "properties": {
              "t_s": { "type": "number", "minimum": 0 },
              "gain": { "type": "number", "minimum": 0, "maximum": 1.5 }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/shot" }
    },
    "narration": {
      "type": "array",
      "items": { "$ref": "#/$defs/line" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "duration": { "type": "number", "exclusiveMinimum": 0 },
    "seed": { "type": "integer", "minimum": 0 },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "seed"],
      "properties": {
        "description": { "$ref": "#/$defs/text" },
        "seed": { "$ref": "#/$defs/seed" }
      }
    },
    "view": {
      "description": "Centre of the view (x, y as fractions of the keyframe) and zoom (1 = whole frame for that aspect ratio).",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "zoom": { "type": "number", "minimum": 1, "maximum": 3 }
      }
    },
    "pan_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/view" },
        "end": { "$ref": "#/$defs/view" }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "act", "duration_s", "type", "characters", "keyframe_prompt", "motion_prompt", "seed", "grade", "pan"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "act": { "enum": ["Mornings", "The fall", "After", "Two cups"] },
        "duration_s": { "$ref": "#/$defs/duration" },
        "type": {
          "description": "pan: FFmpeg pan and zoom across the keyframe. moving: video model from the keyframe, falling back to the pan shot.",
          "enum": ["pan", "moving"]
        },
        "characters": {
          "description": "Which fixed character descriptions the keyframe prompt includes.",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["father", "son", "coffee_corner"] }
        },
        "keyframe_prompt": { "$ref": "#/$defs/text" },
        "motion_prompt": { "$ref": "#/$defs/text" },
        "seed": { "$ref": "#/$defs/seed" },
        "grade": { "enum": ["copper", "gold"] },
        "references": {
          "description": "Which character-sheet images to pass as reference images for this keyframe (overrides the default: all of the shot's characters when style.reference_images is true). An empty list means descriptions and seed only.",
          "type": "array",
          "items": { "enum": ["father", "son", "coffee_corner"] }
        },
        "pan": {
          "description": "Pan path per aspect ratio. Every shot has one, so a moving shot can fall back to its pan shot.",
          "type": "object",
          "additionalProperties": false,
          "required": ["16:9", "9:16"],
          "properties": {
            "16:9": { "$ref": "#/$defs/pan_path" },
            "9:16": { "$ref": "#/$defs/pan_path" }
          }
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "shot", "offset_s", "en", "am", "am_pinned", "am_reviewed"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "shot": { "description": "Id of the shot this line is anchored to.", "type": "integer", "minimum": 1 },
        "offset_s": { "description": "Seconds after the anchored shot's start.", "type": "number", "minimum": 0 },
        "en": { "description": "English text; also the burned-in subtitle.", "$ref": "#/$defs/text" },
        "am": { "description": "Amharic text spoken by the narrator; null until drafted.", "type": ["string", "null"] },
        "am_pinned": { "description": "True if the author wrote the Amharic; the script stage never overwrites it.", "type": "boolean" },
        "am_reviewed": { "description": "True once the author has checked the Amharic. The final film refuses unreviewed lines.", "type": "boolean" },
        "am_from_en": { "description": "The English the Amharic was drafted from, written by the script stage. When `en` no longer matches, the line is redrafted and marked unreviewed.", "type": ["string", "null"] }
      }
    }
  }
}
