# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Every variable is optional: with no keys, `make film` rebuilds the film from committed outputs.

# Google AI Studio key: Gemini text (Amharic draft) and Gemini TTS (narration)
GEMINI_API_KEY=

# Cloudflare Workers AI: FLUX.2 klein keyframes and character sheet
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Kaggle (Wan 2.2 moving shots, ACE-Step score). From kaggle.com > Settings > API.
KAGGLE_USERNAME=
KAGGLE_KEY=
